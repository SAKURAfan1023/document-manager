{
  "schema_version": 1,
  "target_mode": "snapshot",
  "boundaries": {
    "allow": [
      ".dev-flow/config.json",
      "package.json",
      "package-lock.json",
      "src/**",
      "tests/**"
    ],
    "freeze": [
      "library/**",
      "server/**"
    ]
  },
  "limits": {
    "max_changed_files": 8,
    "max_added_lines": 2000,
    "max_deleted_lines": 100
  },
  "execution_guard": {
    "same_failure": {
      "max_consecutive_without_progress": 2,
      "max_total_per_task": 4
    },
    "stall": {
      "max_no_activity_cycles": 2,
      "max_no_outcome_progress_cycles": 3,
      "min_elapsed_seconds": 300,
      "min_tool_calls": 6,
      "min_uncached_tokens": 50000
    },
    "diff_warning_ratio": 0.7,
    "baseline_max_file_bytes": 2097152
  },
  "checks": [
    {
      "id": "typecheck",
      "argv": ["npm", "run", "typecheck"],
      "timeout_seconds": 300,
      "required": true
    },
    {
      "id": "tests",
      "argv": ["npm", "test"],
      "timeout_seconds": 300,
      "required": true
    }
  ]
}
